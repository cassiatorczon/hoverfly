{
	"name": "Hoverfly",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"onCreateCommand": "lake build",
	"customizations": {
		"vscode": {
			"extensions": [
				"leanprover.lean4"
			],
			"settings": {
				"lean4.automaticallyBuildDependencies": true,
				"chat.disableAIFeatures": true,
				"chat.extensionUnification.enabled": false,
				"C_Cpp.copilotHover": "disabled"
			}
		},
		"codespaces": {
			"openFiles": [
				"Hoverfly/Examples.lean"
			]
		}
	}
}