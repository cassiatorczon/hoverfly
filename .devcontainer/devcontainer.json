{
	"name": "Hoverfly",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"onCreateCommand": "lake exe cache get!",
	"customizations": {
		"vscode": {
			"extensions": [
				"leanprover.lean4"
			],
			"settings": {
				"chat.disableAIFeatures": true,
				"chat.extensionUnification.enabled": false,
				"C_Cpp.copilotHover": "disabled"
			}
		},
		"codespaces": {
			"openFiles": [
				"../Hoverfly/Examples.lean"
			]
		}
	}
}