// from https://github.com/leanprover-community/ProofWidgets4/blob/main/widget/rollup.config.js
{
  "compilerOptions": {
    /* Language and environment */
    "target": "esnext",
    "jsx": "react-jsx",
    /* Modules */
    "module": "esnext",
    "moduleResolution": "bundler",
    /* Emit code */
    "sourceMap": false,
    "rootDir": "./src/",
    "outDir": "./dist/",
    /* Emit declarations */
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    /* Interop constraints */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    /* Typechecking */
    "strict": true,
    "isolatedModules": true,
    /* Completeness */
    "skipLibCheck": true,
    "noEmit": false
  },
  // Tests live in ./test and are run directly with `tsx` (see the "test" npm
  // script), so they are intentionally outside this build's includes.
  "include": [
    "./src/*.ts",
    "./src/*.tsx"
  ]
}